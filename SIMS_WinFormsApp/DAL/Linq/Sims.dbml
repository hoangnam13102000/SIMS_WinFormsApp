      <Column Name="OldValue" Type="System.String" DbType="NVarChar(MAX)" CanBeNull="true" UpdateCheck="Never" />
      <Column Name="NewValue" Type="System.String" DbType="NVarChar(MAX)" CanBeNull="true" UpdateCheck="Never" />
      <Column Name="Detail" Type="System.String" DbType="NVarChar(MAX)" CanBeNull="true" UpdateCheck="Never" />
      <Column Name="IPAddress" Type="System.String" DbType="VarChar(45)" CanBeNull="true" />
      <Column Name="CreatedAt" Type="System.DateTime" DbType="DateTime NOT NULL" CanBeNull="false" />
      <Association Name="UserEntity_AuditLogEntity" Member="Users" ThisKey="UserID" OtherKey="UserID" Type="UserEntity" IsForeignKey="true" />
    </Type>
  </Table>
