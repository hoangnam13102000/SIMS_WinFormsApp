<?xml version="1.0" encoding="utf-8"?><Database Name="SIMS_DB" EntityNamespace="SIMS_WinFormsApp.DAL.Linq.Entities" ContextNamespace="SIMS_WinFormsApp.DAL.Linq" Class="SimsDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="AuditLogs">
