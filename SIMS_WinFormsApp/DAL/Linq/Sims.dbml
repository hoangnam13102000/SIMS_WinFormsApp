  <Table Name="InvoiceDetails">
    <Type Name="InvoiceDetailEntity">
      <Column Name="InvoiceDetailID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="InvoiceID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="ProductID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="Quantity" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="UnitPrice" Type="System.Decimal" DbType="Decimal(18,0) NOT NULL" CanBeNull="false" />
      <Column Name="LineTotal" Type="System.Decimal" DbType="Decimal(29,0)" CanBeNull="true" UpdateCheck="Never" Expression="([Quantity]*[UnitPrice])" />
      <Association Name="InvoiceDetailEntity_InvoiceDetailBatchEntity" Member="InvoiceDetailBatches" ThisKey="InvoiceDetailID" OtherKey="InvoiceDetailID" Type="InvoiceDetailBatchEntity" />
      <Association Name="InvoiceEntity_InvoiceDetailEntity" Member="Invoices" ThisKey="InvoiceID" OtherKey="InvoiceID" Type="InvoiceEntity" IsForeignKey="true" />
