  <Table Name="Invoices">
    <Type Name="InvoiceEntity">
      <Column Name="InvoiceID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="InvoiceCode" Type="System.String" DbType="VarChar(30) NOT NULL" CanBeNull="false" />
      <Column Name="CreatedBy" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="CustomerID" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="CreatedAt" Type="System.DateTime" DbType="DateTime NOT NULL" CanBeNull="false" />
      <Column Name="SubTotal" Type="System.Decimal" DbType="Decimal(18,0) NOT NULL" CanBeNull="false" />
      <Column Name="DiscountAmount" Type="System.Decimal" DbType="Decimal(18,0) NOT NULL" CanBeNull="false" />
      <Column Name="VATRate" Type="System.Decimal" DbType="Decimal(5,2) NOT NULL" CanBeNull="false" />
      <Column Name="VATAmount" Type="System.Decimal" DbType="Decimal(29,6)" CanBeNull="true" UpdateCheck="Never" Expression="(case when ([SubTotal]-[DiscountAmount])&lt;(0) then (0) else (([SubTotal]-[DiscountAmount])*[VATRate])/(100) end)" />
      <Column Name="TotalAmount" Type="System.Decimal" DbType="Decimal(18,0) NOT NULL" CanBeNull="false" />
      <Column Name="PaymentMethod" Type="System.String" DbType="VarChar(20) NOT NULL" CanBeNull="false" />
      <Column Name="PayPalOrderID" Type="System.String" DbType="VarChar(50)" CanBeNull="true" />
      <Column Name="PayPalCaptureID" Type="System.String" DbType="VarChar(50)" CanBeNull="true" />
      <Column Name="Status" Type="System.String" DbType="VarChar(20) NOT NULL" CanBeNull="false" />
      <Column Name="CancelReason" Type="System.String" DbType="NVarChar(255)" CanBeNull="true" />
      <Column Name="CancelledAt" Type="System.DateTime" DbType="DateTime" CanBeNull="true" />
      <Column Name="PointsUsed" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="PointsDiscountAmount" Type="System.Decimal" DbType="Decimal(18,0) NOT NULL" CanBeNull="false" />
      <Association Name="InvoiceEntity_InvoiceDetailEntity" Member="InvoiceDetails" ThisKey="InvoiceID" OtherKey="InvoiceID" Type="InvoiceDetailEntity" />
      <Association Name="InvoiceEntity_ReturnExchangeEntity" Member="ReturnExchanges" ThisKey="InvoiceID" OtherKey="InvoiceID" Type="ReturnExchangeEntity" />
      <Association Name="UserEntity_InvoiceEntity" Member="Users" ThisKey="CreatedBy" OtherKey="UserID" Type="UserEntity" IsForeignKey="true" />
      <Association Name="CustomerEntity_InvoiceEntity" Member="Customers" ThisKey="CustomerID" OtherKey="CustomerID" Type="CustomerEntity" IsForeignKey="true" />
    </Type>
  </Table>
