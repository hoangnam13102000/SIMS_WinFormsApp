    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Store">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Parameters!TenCuaHang.Value</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
