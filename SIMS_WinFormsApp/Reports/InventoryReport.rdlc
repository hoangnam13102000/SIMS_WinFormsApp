            <Width>26cm</Width>
            <Style />
          </Textbox>
          <Textbox Name="ReportTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>BÁO CÁO TỒN KHO</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#2563eb</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>1cm</Top>
            <Left>0.2cm</Left>
            <Height>0.7cm</Height>
            <Width>26cm</Width>
            <ZIndex>1</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="ReportScope">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Từ " &amp; Format(Parameters!TuNgay.Value, "dd/MM/yyyy") &amp; " đến " &amp; Format(Parameters!DenNgay.Value, "dd/MM/yyyy") &amp; "  |  Danh mục: " &amp; Parameters!TenDanhMuc.Value &amp; "  |  Kỳ: " &amp; Parameters!KyBaoCao.Value</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>1.8cm</Top>
            <Left>0.2cm</Left>
            <Height>0.55cm</Height>
            <Width>26cm</Width>
            <ZIndex>2</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="Summary">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Sản phẩm: " &amp; Format(First(Fields!ProductCount.Value, "InventorySummaryDataSet"), "N0") &amp; "     Tổng tồn: " &amp; Format(First(Fields!TotalQuantity.Value, "InventorySummaryDataSet"), "N0") &amp; "     Giá trị tồn: " &amp; Format(First(Fields!TotalStockValue.Value, "InventorySummaryDataSet"), "N0") &amp; " đ     Cần bổ sung: " &amp; Format(First(Fields!LowStockProductCount.Value, "InventorySummaryDataSet"), "N0") &amp; "     Hàng hết hạn: " &amp; Format(First(Fields!ExpiredQuantity.Value, "InventorySummaryDataSet"), "N0")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>2.45cm</Top>
            <Left>0.2cm</Left>
            <Height>0.7cm</Height>
            <Width>26cm</Width>
            <ZIndex>3</ZIndex>
            <Style>
              <BackgroundColor>#eff6ff</BackgroundColor>
              <PaddingLeft>4pt</PaddingLeft>
              <PaddingTop>3pt</PaddingTop>
            </Style>
