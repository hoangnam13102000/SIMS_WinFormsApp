<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="SIMSDataSource"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>LocalReport</ConnectString></ConnectionProperties><rd:DataSourceID>62cd20ba-61b3-411e-86b4-9ed89f90d253</rd:DataSourceID></DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DisposalSummaryDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="DisposalCount"><DataField>DisposalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ProductQuantity"><DataField>ProductQuantity</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="TotalLoss"><DataField>TotalLoss</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
    </Fields></DataSet>
    <DataSet Name="DisposalReasonsDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="Reason"><DataField>Reason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DisposalCount"><DataField>DisposalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ProductQuantity"><DataField>ProductQuantity</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="LossAmount"><DataField>LossAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
    </Fields></DataSet>
    <DataSet Name="DisposalProductsDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="LossAmount"><DataField>LossAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
    </Fields></DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="TenCuaHang"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Tên cửa hàng</Prompt></ReportParameter>
    <ReportParameter Name="TuNgay"><DataType>DateTime</DataType><Nullable>true</Nullable><Prompt>Từ ngày</Prompt></ReportParameter>
    <ReportParameter Name="DenNgay"><DataType>DateTime</DataType><Nullable>true</Nullable><Prompt>Đến ngày</Prompt></ReportParameter>
    <ReportParameter Name="TenDanhMuc"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Tên danh mục</Prompt></ReportParameter>
    <ReportParameter Name="NguoiLap"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Người lập</Prompt></ReportParameter>
    <ReportParameter Name="GiamDoc"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Giám đốc</Prompt></ReportParameter>
    <ReportParameter Name="QuanLyKho"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Quản lý kho</Prompt></ReportParameter>
    <ReportParameter Name="NgayLap"><DataType>DateTime</DataType><Nullable>true</Nullable><Prompt>Ngày lập</Prompt></ReportParameter>
    <ReportParameter Name="KyBaoCao"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Kỳ báo cáo</Prompt></ReportParameter>
  </ReportParameters>
  <Language>vi-VN</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <ReportSections><ReportSection><Body>
    <ReportItems>
      <Textbox Name="Store"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!TenCuaHang.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E293B</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>0.15cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>26cm</Width><Style /></Textbox>
      <Textbox Name="Title"><Paragraphs><Paragraph><TextRuns><TextRun><Value>BÁO CÁO TIÊU HỦY HÀNG HÓA</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#C2410C</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>1.0cm</Top><Left>0.2cm</Left><Height>0.7cm</Height><Width>26cm</Width><Style /></Textbox>
      <Textbox Name="Scope"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Từ " &amp; Format(Parameters!TuNgay.Value, "dd/MM/yyyy") &amp; " đến " &amp; Format(Parameters!DenNgay.Value, "dd/MM/yyyy") &amp; "  |  " &amp; Parameters!KyBaoCao.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>1.8cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>26cm</Width><Style /></Textbox>
      <Textbox Name="Summary"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="SỐ PHIẾU: " &amp; Format(First(Fields!DisposalCount.Value, "DisposalSummaryDataSet"), "N0") &amp; "        SỐ LƯỢNG: " &amp; Format(First(Fields!ProductQuantity.Value, "DisposalSummaryDataSet"), "N0") &amp; "        TỔNG THIỆT HẠI: " &amp; Format(First(Fields!TotalLoss.Value, "DisposalSummaryDataSet"), "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>2.45cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>26cm</Width><Style><BackgroundColor>#FFF7ED</BackgroundColor><PaddingLeft>5pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="ReasonsTitle"><Paragraphs><Paragraph><TextRuns><TextRun><Value>THỐNG KÊ THEO LÝ DO</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>3.5cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>12cm</Width><Style /></Textbox>
      <Tablix Name="ReasonsTable"><TablixBody><TablixColumns><TablixColumn><Width>4.0cm</Width></TablixColumn><TablixColumn><Width>2.0cm</Width></TablixColumn><TablixColumn><Width>2.3cm</Width></TablixColumn><TablixColumn><Width>3.7cm</Width></TablixColumn></TablixColumns><TablixRows>
        <TablixRow><Height>0.65cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ReasonH1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Lý do</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReasonH2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Số phiếu</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReasonH3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Số lượng</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReasonH4"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Thiệt hại</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
        <TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ReasonD1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Reason.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReasonD2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!DisposalCount.Value, "N0")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReasonD3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!ProductQuantity.Value, "N0")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReasonD4"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LossAmount.Value, "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
      </TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="DisposalReasons" /></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>DisposalReasonsDataSet</DataSetName><NoRowsMessage>Không có số liệu theo lý do tiêu hủy.</NoRowsMessage><Top>4.05cm</Top><Left>0.2cm</Left><Height>1.25cm</Height><Width>12cm</Width><Style><Border><Style>Solid</Style><Color>#FED7AA</Color></Border><FontSize>8pt</FontSize></Style></Tablix>
      <Textbox Name="ProductsTitle"><Paragraphs><Paragraph><TextRuns><TextRun><Value>THỐNG KÊ THEO SẢN PHẨM</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>3.5cm</Top><Left>12.5cm</Left><Height>0.5cm</Height><Width>12cm</Width><Style /></Textbox>
      <Tablix Name="ProductsTable"><TablixBody><TablixColumns><TablixColumn><Width>6.0cm</Width></TablixColumn><TablixColumn><Width>2.0cm</Width></TablixColumn><TablixColumn><Width>4.0cm</Width></TablixColumn></TablixColumns><TablixRows>
        <TablixRow><Height>0.65cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProductH1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sản phẩm</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProductH2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Số lượng</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProductH3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Thiệt hại</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#C2410C</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
        <TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProductD1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Name.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProductD2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Quantity.Value, "N0")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProductD3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LossAmount.Value, "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#FFF7ED</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
