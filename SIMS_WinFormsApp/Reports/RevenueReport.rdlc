<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="SIMSDataSource"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>LocalReport</ConnectString></ConnectionProperties><rd:DataSourceID>dd5e1447-dda5-4db4-b593-7d3627112190</rd:DataSourceID></DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RevenueSummaryDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="Revenue"><DataField>Revenue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="OrderCount"><DataField>OrderCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    </Fields></DataSet>
    <DataSet Name="RevenueTrendDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="PeriodStart"><DataField>PeriodStart</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Revenue"><DataField>Revenue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="OrderCount"><DataField>OrderCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    </Fields></DataSet>
    <DataSet Name="RevenueCategoriesDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Revenue"><DataField>Revenue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
    </Fields></DataSet>
    <DataSet Name="RevenueTopProductsDataSet"><Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query><Fields>
      <Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Revenue"><DataField>Revenue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
    </Fields></DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="TenCuaHang"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Tên cửa hàng</Prompt></ReportParameter>
    <ReportParameter Name="TuNgay"><DataType>DateTime</DataType><Nullable>true</Nullable><Prompt>Từ ngày</Prompt></ReportParameter>
    <ReportParameter Name="DenNgay"><DataType>DateTime</DataType><Nullable>true</Nullable><Prompt>Đến ngày</Prompt></ReportParameter>
    <ReportParameter Name="TenDanhMuc"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Tên danh mục</Prompt></ReportParameter>
    <ReportParameter Name="NguoiLap"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Người lập</Prompt></ReportParameter>
    <ReportParameter Name="GiamDoc"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Giám đốc</Prompt></ReportParameter>
    <ReportParameter Name="QuanLyKho"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Quản lý kho</Prompt></ReportParameter>
    <ReportParameter Name="NgayLap"><DataType>DateTime</DataType><Nullable>true</Nullable><Prompt>Ngày lập</Prompt></ReportParameter>
    <ReportParameter Name="KyBaoCao"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>Kỳ báo cáo</Prompt></ReportParameter>
  </ReportParameters>
  <Language>vi-VN</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <ReportSections><ReportSection><Body>
    <ReportItems>
      <Textbox Name="Store"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!TenCuaHang.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E293B</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>0.15cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>26cm</Width><Style /></Textbox>
      <Textbox Name="Title"><Paragraphs><Paragraph><TextRuns><TextRun><Value>BÁO CÁO DOANH THU</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#2563EB</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>1.0cm</Top><Left>0.2cm</Left><Height>0.7cm</Height><Width>26cm</Width><Style /></Textbox>
      <Textbox Name="Scope"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Từ " &amp; Format(Parameters!TuNgay.Value, "dd/MM/yyyy") &amp; " đến " &amp; Format(Parameters!DenNgay.Value, "dd/MM/yyyy") &amp; "  |  " &amp; Parameters!KyBaoCao.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>1.8cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>26cm</Width><Style /></Textbox>
      <Textbox Name="Summary"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="TỔNG DOANH THU: " &amp; Format(First(Fields!Revenue.Value, "RevenueSummaryDataSet"), "N0") &amp; " đ        SỐ ĐƠN HÀNG: " &amp; Format(First(Fields!OrderCount.Value, "RevenueSummaryDataSet"), "N0")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#0F172A</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>2.4cm</Top><Left>0.2cm</Left><Height>0.8cm</Height><Width>26cm</Width><Style><BackgroundColor>#EFF6FF</BackgroundColor><PaddingLeft>5pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="TrendTitle"><Paragraphs><Paragraph><TextRuns><TextRun><Value>XU HƯỚNG DOANH THU</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>3.4cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>18cm</Width><Style /></Textbox>
      <Chart Name="RevenueTrendChart">
        <ChartCategoryHierarchy><ChartMembers><ChartMember><Label>=Fields!PeriodStart.Value</Label><Group Name="TrendCategory"><GroupExpressions><GroupExpression>=Fields!PeriodStart.Value</GroupExpression></GroupExpressions></Group></ChartMember></ChartMembers></ChartCategoryHierarchy>
        <ChartSeriesHierarchy><ChartMembers><ChartMember><Label>="Doanh thu"</Label><Group Name="TrendSeries"><GroupExpressions><GroupExpression>="Doanh thu"</GroupExpression></GroupExpressions></Group></ChartMember></ChartMembers></ChartSeriesHierarchy>
        <ChartData><ChartSeriesCollection><ChartSeries Name="Revenue"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!Revenue.Value)</Y></ChartDataPointValues><ChartDataLabel><Style /></ChartDataLabel><Style><Color>#2563EB</Color></Style></ChartDataPoint></ChartDataPoints></ChartSeries></ChartSeriesCollection></ChartData>
        <ChartAreas><ChartArea Name="Default"><Style><Border><Color>LightGrey</Color></Border><BackgroundColor>White</BackgroundColor></Style></ChartArea></ChartAreas>
        <ChartTitles><ChartTitle Name="Default"><Caption>Doanh thu theo kỳ</Caption><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style></ChartTitle></ChartTitles>
        <Palette>BrightPastel</Palette><DataSetName>RevenueTrendDataSet</DataSetName><Top>3.95cm</Top><Left>0.2cm</Left><Height>5.5cm</Height><Width>18.8cm</Width><Style><Border><Style>Solid</Style><Color>#E2E8F0</Color></Border></Style>
      </Chart>
      <Textbox Name="CategoriesTitle"><Paragraphs><Paragraph><TextRuns><TextRun><Value>DOANH THU THEO DANH MỤC</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>9.65cm</Top><Left>0.2cm</Left><Height>0.5cm</Height><Width>9cm</Width><Style /></Textbox>
      <Tablix Name="CategoriesTable"><TablixBody><TablixColumns><TablixColumn><Width>5.4cm</Width></TablixColumn><TablixColumn><Width>4.0cm</Width></TablixColumn></TablixColumns><TablixRows>
        <TablixRow><Height>0.65cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="CatH1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Danh mục</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1D4ED8</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CatH2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Doanh thu</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1D4ED8</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
        <TablixRow><Height>0.58cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="CatD1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Name.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#F8FAFC</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CatD2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Revenue.Value, "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#F8FAFC</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
      </TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="RevenueCategories" /></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>RevenueCategoriesDataSet</DataSetName><NoRowsMessage>Không có dữ liệu doanh thu theo danh mục.</NoRowsMessage><Top>10.2cm</Top><Left>0.2cm</Left><Height>1.23cm</Height><Width>9.4cm</Width><Style><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><FontSize>8pt</FontSize></Style></Tablix>
      <Textbox Name="ProductsTitle"><Paragraphs><Paragraph><TextRuns><TextRun><Value>SẢN PHẨM BÁN CHẠY</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>9.65cm</Top><Left>10.0cm</Left><Height>0.5cm</Height><Width>9cm</Width><Style /></Textbox>
      <Tablix Name="TopProductsTable"><TablixBody><TablixColumns><TablixColumn><Width>5.0cm</Width></TablixColumn><TablixColumn><Width>2.0cm</Width></TablixColumn><TablixColumn><Width>3.0cm</Width></TablixColumn></TablixColumns><TablixRows>
        <TablixRow><Height>0.65cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProdH1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sản phẩm</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1D4ED8</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdH2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Số lượng</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1D4ED8</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdH3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Doanh thu</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1D4ED8</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
        <TablixRow><Height>0.58cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProdD1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Name.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#F8FAFC</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdD2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Quantity.Value, "N0")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#F8FAFC</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdD3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Revenue.Value, "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#F8FAFC</BackgroundColor><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
