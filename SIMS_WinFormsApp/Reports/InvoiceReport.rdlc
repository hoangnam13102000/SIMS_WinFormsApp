<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SIMSDataSource">
      <ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>LocalReport</ConnectString></ConnectionProperties>
      <rd:DataSourceID>e0c51164-3a61-42f3-a998-8a5244b27a55</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InvoiceHeaderDataSet">
      <Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query>
      <Fields>
        <Field Name="InvoiceCode"><DataField>InvoiceCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CreatedAt"><DataField>CreatedAt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="CustomerName"><DataField>CustomerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CashierName"><DataField>CashierName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PaymentMethod"><DataField>PaymentMethod</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Subtotal"><DataField>Subtotal</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="DiscountAmount"><DataField>DiscountAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PointsDiscountAmount"><DataField>PointsDiscountAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="VatRate"><DataField>VatRate</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="VatAmount"><DataField>VatAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalAmount"><DataField>TotalAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="IsCancelled"><DataField>IsCancelled</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="InvoiceLinesDataSet">
      <Query><DataSourceName>SIMSDataSource</DataSourceName><CommandText>LocalReport</CommandText></Query>
      <Fields>
        <Field Name="ProductName"><DataField>ProductName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="UnitPrice"><DataField>UnitPrice</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="LineTotal"><DataField>LineTotal</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <EmbeddedImages>
    <EmbeddedImage Name="ReceiptLogo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>
  <Language>vi-VN</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="InvoiceLayout">
            <TablixBody>
              <TablixColumns><TablixColumn><Width>7.6cm</Width></TablixColumn></TablixColumns>
              <TablixRows>
                <TablixRow><Height>1.8cm</Height><TablixCells><TablixCell><CellContents><Image Name="ReceiptLogo"><Source>Embedded</Source><Value>ReceiptLogo</Value><MIMEType>image/png</MIMEType><Sizing>FitProportional</Sizing><Style><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Image></CellContents><DataElementOutput>NoOutput</DataElementOutput></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="StoreName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>SIMS</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>Bold</FontWeight><Color>#0F172A</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.45cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ReportTitle"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>HÓA ĐƠN BÁN HÀNG</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.45cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="InvoiceCode"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Mã hóa đơn: " &amp; First(Fields!InvoiceCode.Value, "InvoiceHeaderDataSet")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E64C8</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="CreatedAt"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(First(Fields!CreatedAt.Value, "InvoiceHeaderDataSet"), "dd/MM/yyyy HH:mm")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#64748B</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.06cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="HeaderSeparator"><CanGrow>false</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#E2E8F0</BackgroundColor><Border><Style>None</Style></Border></Style></Textbox></CellContents><DataElementOutput>NoOutput</DataElementOutput></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="CustomerName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Khách hàng: " &amp; First(Fields!CustomerName.Value, "InvoiceHeaderDataSet")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#1E293B</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="CashierName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Nhân viên: " &amp; First(Fields!CashierName.Value, "InvoiceHeaderDataSet")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#1E293B</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.06cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProductSeparator"><CanGrow>false</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#E2E8F0</BackgroundColor><Border><Style>None</Style></Border></Style></Textbox></CellContents><DataElementOutput>NoOutput</DataElementOutput></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.9cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProductLine"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                  <Paragraphs>
                    <Paragraph><TextRuns><TextRun><Value>=Fields!ProductName.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E293B</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign><PaddingBottom>1pt</PaddingBottom></Style></Paragraph>
                    <Paragraph><TextRuns><TextRun><Value>=CStr(Fields!Quantity.Value) &amp; " x " &amp; Format(Fields!UnitPrice.Value, "N0") &amp; " đ     " &amp; Format(Fields!LineTotal.Value, "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph>
                  </Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.06cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="TotalsSeparator"><CanGrow>false</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#E2E8F0</BackgroundColor><Border><Style>None</Style></Border></Style></Textbox></CellContents><DataElementOutput>NoOutput</DataElementOutput></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Subtotal"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Tạm tính: " &amp; Format(First(Fields!Subtotal.Value, "InvoiceHeaderDataSet"), "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Discount"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Giảm giá: " &amp; Format(First(Fields!DiscountAmount.Value, "InvoiceHeaderDataSet") + First(Fields!PointsDiscountAmount.Value, "InvoiceHeaderDataSet"), "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="VatAmount"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>="VAT (" &amp; Format(First(Fields!VatRate.Value, "InvoiceHeaderDataSet"), "0.##") &amp; "%): " &amp; Format(First(Fields!VatAmount.Value, "InvoiceHeaderDataSet"), "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="TotalCaption"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>TỔNG THANH TOÁN</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E293B</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.65cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="TotalAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(First(Fields!TotalAmount.Value, "InvoiceHeaderDataSet"), "N0") &amp; " đ"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>Bold</FontWeight><Color>#1E64C8</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="PaymentMethod"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Thanh toán: " &amp; Switch(First(Fields!PaymentMethod.Value, "InvoiceHeaderDataSet") = "CASH", "Tiền mặt", First(Fields!PaymentMethod.Value, "InvoiceHeaderDataSet") = "BANK_TRANSFER", "Chuyển khoản", First(Fields!PaymentMethod.Value, "InvoiceHeaderDataSet") = "PAYPAL", "PayPal", First(Fields!PaymentMethod.Value, "InvoiceHeaderDataSet") = "CARD", "Thẻ", True, IIF(IsNothing(First(Fields!PaymentMethod.Value, "InvoiceHeaderDataSet")), "", CStr(First(Fields!PaymentMethod.Value, "InvoiceHeaderDataSet"))))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Footer"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(First(Fields!IsCancelled.Value, "InvoiceHeaderDataSet"), "HÓA ĐƠN ĐÃ HỦY", "Cảm ơn quý khách!")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>=IIF(First(Fields!IsCancelled.Value, "InvoiceHeaderDataSet"), "#DC2626", "#15803D")</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy>
            <TablixRowHierarchy><TablixMembers>
              <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember><Group Name="InvoiceLinesDetails" /></TablixMember><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
            </TablixMembers></TablixRowHierarchy>
            <DataSetName>InvoiceLinesDataSet</DataSetName><NoRowsMessage>Không có dữ liệu hóa đơn.</NoRowsMessage><KeepTogether>true</KeepTogether><Top>0.1cm</Top><Left>0.2cm</Left><Height>8.83cm</Height><Width>7.6cm</Width><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
          </Tablix>
        </ReportItems>
        <Height>8.93cm</Height><Style />
      </Body>
      <Width>7.6cm</Width>
      <Page>
        <PageHeight>100cm</PageHeight><PageWidth>8cm</PageWidth>
        <LeftMargin>0.2cm</LeftMargin><RightMargin>0.2cm</RightMargin><TopMargin>0.2cm</TopMargin><BottomMargin>0.2cm</BottomMargin>
        <InteractiveHeight>0cm</InteractiveHeight><InteractiveWidth>0cm</InteractiveWidth>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportID>3c2b128d-8c48-4a14-87e0-a663440f4e3a</rd:ReportID>
</Report>
